/dts-v1/;

#include <thead/th1520.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pinctrl/th1520-pinctrl.h>

/ {
	model = "BeagleBoard.org BeagleV-Ahead";
	compatible = "beagle,beaglev-ahead", "thead,th1520";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,bt-hci = &bt_hci_uart;
		zephyr,canbus = &mcp2518fd;
		zephyr,sram = &dram0;
	};

	aliases {
		led0 = &usr_led0;
		led1 = &usr_led1;
		led2 = &usr_led2;
		led3 = &usr_led3;
		led4 = &usr_led4;
		eeprom-0 = &eeprom0;
		watchdog0 = &wdt0;
		pwm-0 = &pwm0;
		rtc = &rtc0;
	};

	leds {
		compatible = "gpio-leds";

		usr_led0: led_0 {
			gpios = <&gpio4 8 GPIO_ACTIVE_HIGH>;
			label = "USR0";
		};

		usr_led1: led_1 {
			gpios = <&gpio4 9 GPIO_ACTIVE_HIGH>;
			label = "USR1";
		};

		usr_led2: led_2 {
			gpios = <&gpio4 10 GPIO_ACTIVE_HIGH>;
			label = "USR2";
		};

		usr_led3: led_3 {
			gpios = <&gpio4 11 GPIO_ACTIVE_HIGH>;
			label = "USR3";
		};

		usr_led4: led_4 {
			gpios = <&gpio4 12 GPIO_ACTIVE_HIGH>;
			label = "USR4";
		};
	};

	mikrobus_header: mikrobus-connector {
		compatible = "mikro-bus";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 GPIO_DT_FLAGS_MASK>;
		gpio-map = <0 0 &gpio3 2 0>,   /* AN   */
			   <1 0 &gpio1 0 0>,   /* RST  */
			   <2 0 &gpio2 15 0>,  /* CS   */
			   <3 0 &gpio2 16 0>,  /* SCK  */
			   <4 0 &gpio2 18 0>,  /* MISO */
			   <5 0 &gpio2 17 0>,  /* MOSI */
			   <6 0 &gpio3 3 0>,   /* PWM  */
			   <7 0 &gpio3 4 0>,   /* INT  */
			   <8 0 &gpio1 6 0>,   /* RX   */
			   <9 0 &gpio1 5 0>,   /* TX   */
			   <10 0 &gpio1 11 0>, /* SCL  */
			   <11 0 &gpio1 12 0>; /* SDA  */
	};
};

&padctrl_aosys {
	status = "okay";
};

&padctrl0_apsys {
	status = "okay";

	i2c3_scl_default: i2c3_scl_default {
		pinmux = <TH1520_PINMUX(11, TH1520_MUX_FUNC1, 0)>;
		bias-pull-up;
		input-enable;
		drive-strength = <8>;
	};

	i2c3_sda_default: i2c3_sda_default {
		pinmux = <TH1520_PINMUX(12, TH1520_MUX_FUNC1, 0)>;
		bias-pull-up;
		input-enable;
		drive-strength = <8>;
	};

	pwm0_ch0_default: pwm0_ch0_default {
		pinmux = <TH1520_PINMUX(3, TH1520_MUX_FUNC1, 0)>;
		drive-strength = <12>;
	};
};

&padctrl1_apsys {
	status = "okay";

	uart0_tx_default: uart0_tx_default {
		pinmux = <TH1520_PINMUX(0, TH1520_MUX_FUNC0, 0)>;
		drive-strength = <8>;
	};

	uart0_rx_default: uart0_rx_default {
		pinmux = <TH1520_PINMUX(1, TH1520_MUX_FUNC0, 0)>;
		bias-pull-up;
		input-enable;
		drive-strength = <8>;
	};

	spi0_sck_default: spi0_sck_default {
		pinmux = <TH1520_PINMUX(16, TH1520_MUX_FUNC0, 0)>;
		drive-strength = <10>;
	};

	spi0_mosi_default: spi0_mosi_default {
		pinmux = <TH1520_PINMUX(17, TH1520_MUX_FUNC0, 0)>;
		drive-strength = <10>;
	};

	spi0_miso_default: spi0_miso_default {
		pinmux = <TH1520_PINMUX(18, TH1520_MUX_FUNC0, 0)>;
		bias-pull-up;
		input-enable;
		drive-strength = <10>;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_tx_default &uart0_rx_default>;
	pinctrl-names = "default";
};

mikrobus_serial: &uart3 {
	status = "okay";
	current-speed = <115200>;
};

&uart4 {
	status = "okay";
	current-speed = <115200>;

	bt_hci_uart: bt_hci_uart {
		compatible = "zephyr,bt-hci-uart";
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

&aogpio {
	status = "okay";
};

&i2c0 {
	status = "okay";

	eeprom0: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		size = <DT_SIZE_K(4)>;
		pagesize = <32>;
		address-width = <16>;
		timeout = <5>;
	};
};

mikrobus_i2c: &i2c3 {
	status = "okay";

	bme280: bme280@76 {
		compatible = "bosch,bme280";
		reg = <0x76>;
	};
};

&aon_i2c {
	status = "okay";
};

mikrobus_spi: &spi0 {
	status = "okay";
	cs-gpios = <&gpio2 15 GPIO_ACTIVE_LOW>;

	mcp2518fd: can@0 {
		compatible = "microchip,mcp251xfd";
		reg = <0>;
		spi-max-frequency = <20000000>;
		osc-freq = <40000000>;
		int-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_ch0_default>;
	pinctrl-names = "default";
};

&pvt0 {
	status = "okay";
};

&rtc0 {
	status = "okay";
};

&dmac0 {
	status = "okay";
};

&mbox0 {
	status = "okay";
};

&gmac0 {
	status = "okay";
};

&mshc0 {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};
