/dts-v1/;

#include <thead/th1520.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "BeagleBoard.org BeagleV-Ahead";
	compatible = "beagle,beaglev-ahead", "thead,th1520";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &dram0;
	};

	aliases {
		led0 = &usr_led0;
		led1 = &usr_led1;
		led2 = &usr_led2;
		led3 = &usr_led3;
		led4 = &usr_led4;
		eeprom-0 = &eeprom0;
		watchdog0 = &wdt0;
	};

	leds {
		compatible = "gpio-leds";

		usr_led0: led_0 {
			gpios = <&gpio4 8 GPIO_ACTIVE_HIGH>;
			label = "USR0";
		};

		usr_led1: led_1 {
			gpios = <&gpio4 9 GPIO_ACTIVE_HIGH>;
			label = "USR1";
		};

		usr_led2: led_2 {
			gpios = <&gpio4 10 GPIO_ACTIVE_HIGH>;
			label = "USR2";
		};

		usr_led3: led_3 {
			gpios = <&gpio4 11 GPIO_ACTIVE_HIGH>;
			label = "USR3";
		};

		usr_led4: led_4 {
			gpios = <&gpio4 12 GPIO_ACTIVE_HIGH>;
			label = "USR4";
		};
	};

	mikrobus_header: mikrobus-connector {
		compatible = "mikro-bus";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 GPIO_DT_FLAGS_MASK>;
		gpio-map = <0 0 &gpio3 2 0>,   /* AN   */
			   <1 0 &gpio1 0 0>,   /* RST  */
			   <2 0 &gpio2 15 0>,  /* CS   */
			   <3 0 &gpio2 16 0>,  /* SCK  */
			   <4 0 &gpio2 18 0>,  /* MISO */
			   <5 0 &gpio2 17 0>,  /* MOSI */
			   <6 0 &gpio3 3 0>,   /* PWM  */
			   <7 0 &gpio3 4 0>,   /* INT  */
			   <8 0 &gpio1 6 0>,   /* RX   */
			   <9 0 &gpio1 5 0>,   /* TX   */
			   <10 0 &gpio1 11 0>, /* SCL  */
			   <11 0 &gpio1 12 0>; /* SDA  */
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};

mikrobus_serial: &uart3 {
	status = "okay";
	current-speed = <115200>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

&aogpio {
	status = "okay";
};

&i2c0 {
	status = "okay";

	eeprom0: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		size = <DT_SIZE_K(4)>;
		pagesize = <32>;
		address-width = <16>;
		timeout = <5>;
	};
};

mikrobus_i2c: &i2c3 {
	status = "okay";
};

&aon_i2c {
	status = "okay";
};

mikrobus_spi: &spi0 {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};
